{
  "manifest_version": 3,
  "name": "Phishing URL Guard - Root-Paired",
  "version": "0.7.0",
  "description": "Research extension using the root-paired HYB-MS model for stable handling of equivalent root URLs.",
  "permissions": ["storage", "tabs", "webNavigation", "offscreen"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Phishing URL Guard - Root-Paired",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["browser_policy.js", "content/caution_banner.js"],
    "css": ["content/caution_banner.css"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "web_accessible_resources": [{
    "resources": ["content/advisory.html", "content/advisory.css", "content/advisory.js"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "options_page": "demo/demo.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
